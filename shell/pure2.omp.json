{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "#6C6C6C",
                    "style": "plain",
                    "template": "{{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}({{ .Venv }}) {{ end }}{{ .Full }}{{ end }} ",
                    "type": "python"
                },
                {
                    "foreground": "#BF616A",
                    "style": "plain",
                    "template": "{{ .UserName }} ",
                    "type": "session"
                },
                {
                    "foreground": "#B48EAD",
                    "style": "plain",
                    "template": "<i>@{{ .HostName }}</i> ",
                    "type": "session"
                },
                {
                    "foreground": "#306daa",
                    "style": "plain",
                    "template": "{{ if .WSL }}<i>wsl</i> {{ end }}",
                    "type": "session"
                },
                {
                    "foreground": "#81A1C1",
                    "properties": {
                        "style": "fish",
                        "dir_length": 1,
                        "full_length_dirs": 2
                    },
                    "style": "plain",
                    "template": "{{ .Path }} ",
                    "type": "path"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "#6C6C6C",
                    "properties": {
                        "branch_icon": "",
                        "fetch_stash_count": true,
                        "fetch_status": true,
                        "github_icon": ""
                    },
                    "style": "plain",
                    "template": "on {{ .HEAD }}{{ if gt .Ahead 0 }} | ahead {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} | behind {{ .Behind }}{{ end }}{{ if .Working.Changed }} | working tree {{ .Working.String }}{{ else }} | working tree clean{{ end }}{{ if .Staging.Changed }} | staged {{ .Staging.String }}{{ else }} | staged none{{ end }}{{ if gt .StashCount 0 }} | stashes {{ .StashCount }}{{ end }} ",
                    "type": "git"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "#A3BE8C",
                    "properties": {
                        "style": "austin"
                    },
                    "style": "plain",
                    "template": "{{ .FormattedMs }} ",
                    "type": "executiontime"
                }
            ],
            "type": "prompt"
        }
    ],
    "console_title_template": "{{ if .WSL }}WSL {{ end }}{{if .Root}}(Admin){{end}} {{.PWD}}",
    "version": 3
}
